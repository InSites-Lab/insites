{
  "name": "insites-chatgpt",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "InSites skills and shared MCP App server",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/http.mjs",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "package:delivery": "node scripts/package-delivery.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm run build && npm test && npm run test:browser"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "atar-runtime": "0.3.8",
    "sanitize-html": "2.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.25.12",
    "playwright": "1.56.1"
  }
}
